{
  "name": "limitwatch-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/package-standalone.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write app components lib scripts next.config.mjs eslint.config.mjs",
    "format:check": "prettier --check app components lib scripts next.config.mjs eslint.config.mjs",
    "start": "node .next/standalone/server.js",
    "test": "node --test lib/proxy.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
